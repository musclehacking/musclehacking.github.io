{
  "name": "musclehacking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "sync:blog-slugs": "node scripts/sync-blog-slugs.mjs",
    "predev": "pnpm sync:blog-slugs",
    "dev": "astro dev",
    "precheck": "pnpm sync:blog-slugs",
    "check": "astro check",
    "pretest": "pnpm sync:blog-slugs",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:agent-a11y": "playwright test --project=chromium tests/a11y",
    "test:visual": "node scripts/visual-parity.mjs",
    "prebuild": "pnpm sync:blog-slugs",
    "build": "astro build && node scripts/shape-routes.mjs && node scripts/finalize-headers.mjs",
    "preview:worker": "wrangler dev --port 8787",
    "preverify:dist": "node scripts/sync-blog-slugs.mjs --check",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typegen": "wrangler types src/env.d.ts",
    "upload:version": "pnpm build && wrangler versions upload"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "6.0.4",
    "astro": "7.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cheerio": "1.2.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
