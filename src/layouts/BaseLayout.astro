---
import Header from '../components/Header.astro';
import BackToTop from '../components/BackToTop.astro';
import PageMetadata from '../components/head/PageMetadata.astro';
import { site } from '../config/site';
import type { PageMetadataInput } from '../lib/metadata';
import '../styles/global.css';
import '../styles/legacy-content.css';

interface Props {
  metadata: PageMetadataInput;
}

const { metadata } = Astro.props;
const { canonicalPath } = metadata;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <PageMetadata {metadata} />
  </head>
  <body id="top">
    <Header canonicalPath={canonicalPath} />
    <slot />
    {/* The audited legacy tree only ships the back-to-top control on these two routes. */}
    {['/calorie-calculator/', '/supplements/'].includes(canonicalPath) && <BackToTop />}
  </body>
</html>
