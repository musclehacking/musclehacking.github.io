---
import ArticleEnding from '../components/article/ArticleEnding.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import type { ArticleModel } from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  article: ArticleModel;
  class?: string;
}

const { article, class: className } = Astro.props;
---

<BaseLayout metadata={article.metadata}>
  <main class:list={['article-page', { 'longform-page': article.longform }, className]}>
    <article>
      <ArticleHeader {article} />
      <div class="legacy-content" data-heading-links={article.ending.headingLinks ? undefined : 'off'}>
        <slot />
      </div>
      <ArticleEnding
        canonicalPath={article.canonicalPath}
        title={article.title}
        documentTitle={article.documentTitle}
        formId={article.formId}
        campaign={article.campaign}
        placement={article.placement}
        previous={article.navigation.previous}
        next={article.navigation.next}
        wrapTitles={article.navigation.wrapTitles}
        disclaimer={article.ending.disclaimer || undefined}
        floatingShare={article.ending.floatingShare}
      />
    </article>
  </main>
</BaseLayout>

<script>
  import '../scripts/heading-links';
</script>
