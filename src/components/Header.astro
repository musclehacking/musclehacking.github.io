interface Props {
  canonicalPath: string;
}

const { canonicalPath } = Astro.props;
const mobileVisibleHref = canonicalPath === '/join/' || canonicalPath === '/one-last-step/' ? '/supplements/' : '/join/';
const visibleNavigation = canonicalPath === '/one-last-step/' ? navigation.filter(([href]) => href !== '/join/') : navigation;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="site-brand" href="/" aria-label="Muscle Hacking home">
      <img class="site-brand-mark" src="/img/muscle-hacking.png" width="52" height="50" alt="" />
      <img class="site-brand-wordmark" src="/img/musclehacking.png" width="416" height="30" alt="" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-links">Menu</button>
    <ul class="nav-links" id="primary-links" data-open="false">
      {visibleNavigation.map(([href, icon, label, iconName]) => <li class:list={{ 'mobile-visible': href === mobileVisibleHref }}><a href={href}><img class={`nav-icon nav-icon--${iconName}`} src={icon} width="28" height="28" alt="" />{label}</a></li>)}
    </ul>
    <div class="header-socials" role="group" aria-label="Social media">
      {socialLinks.map(({ label, href, icon, viewBox, path }) => (
        <a class={`header-social-link header-social-link--${icon}`} href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
          <svg viewBox={viewBox} aria-hidden="true" focusable="false"><path d={path}></path></svg>
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  import '../scripts/navigation';
</script>
