---
import Icon from '../Icon.astro';
import { absoluteUrl, site } from '../../config/site';
interface Props {
  canonicalPath: string;
  title: string;
  twitterText?: string;
}

const { canonicalPath, title, twitterText } = Astro.props;
const url = absoluteUrl(canonicalPath);
const twitterHref = twitterText
  ? `https://twitter.com/intent/tweet?text=${twitterText}`
  : `https://twitter.com/intent/tweet?text=Interesting+read:%20${url}%20via%20@${site.socialHandle}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
---

<section id="share" class="share-links" data-share-title={title}>
  <h3 id="share-t">Share</h3>
  <a aria-label="Share on Twitter" href={twitterHref} rel="noopener nofollow" target="_blank" title="Share on Twitter">
    <Icon name="twitterInline" class="icon share-icon share-icon--twitter" />
  </a>
  <a aria-label="Share on Facebook" href={facebookHref} rel="noopener nofollow" target="_blank" title="Share on Facebook">
    <Icon name="facebookInline" class="icon share-icon share-icon--facebook" />
  </a>
</section>
<section id="comm">
  <h3 id="comm-t">Comment</h3>
  <a aria-label="Comment on Reddit" href={site.communityUrl} target="_blank" rel="noopener" title="Comment on Reddit">
    <Icon name="redditInline" id="reddit-p" />
  </a>
</section>
