---
import ShareRailItem from './ShareRailItem.astro';
import Icon from '../Icon.astro';
import { absoluteUrl, site } from '../../config/site';
interface Props {
  canonicalPath: string;
  title: string;
  documentTitle: string;
  emailSubject?: string;
  emailBody?: string;
}

const {
  canonicalPath,
  title,
  documentTitle,
  emailSubject = 'Worth a read',
  emailBody,
} = Astro.props;
const url = absoluteUrl(canonicalPath);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDocumentTitle = encodeURIComponent(documentTitle);
const twitterHref = `https://twitter.com/intent/tweet?text=${encodedTitle}%20${encodedUrl}&via=${site.socialHandle}`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&title=${encodedDocumentTitle}`;
const linkedInHref = `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedDocumentTitle}`;
const emailHref = `mailto:?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody ?? `You might find this interesting: ${url}`)}`;


