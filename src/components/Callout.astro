---
import Icon from './Icon.astro';
interface Props {
  label?: string;
  variant?: 'note' | 'important' | 'warning';
  class?: string;
}

const {
  label = 'Note',
  variant = 'note',
  class: className = '',
} = Astro.props;

const iconClasses = {
  note: 'octicon-info',
  important: 'octicon-report',
  warning: 'octicon-alert',
} as const;
---

<aside class:list={['project-callout', `project-callout--${variant}`, className]} aria-label={label}>
  <strong class="alert-title">
    <Icon name={variant} class:list={['octicon', iconClasses[variant]]} width="16" height="16" pathFill="currentColor" />
    {label}
  </strong>
  {' '}
  <div class="alert-content"><slot /></div>
</aside>
