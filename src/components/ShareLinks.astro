---
interface Props {
  canonicalPath: string;
  title: string;
  twitterText?: string;
}

const { canonicalPath, title, twitterText } = Astro.props;
const url = `https://www.musclehacking.com${canonicalPath}`;
const twitterHref = twitterText
  ? `https://twitter.com/intent/tweet?text=${twitterText}`
  : `https://twitter.com/intent/tweet?text=Interesting+read:%20${url}%20via%20@musclehacking`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
---

<section id="share" class="share-links" data-share-title={title}>
  <h3 id="share-t">Share</h3>
  <a aria-label="Share on Twitter" href={twitterHref} rel="noopener nofollow" target="_blank" title="Share on Twitter">
    <svg class="icon share-icon share-icon--twitter" viewBox="0 0 951 1024" aria-hidden="true"><path d="M925.714 233.143q-38.286 56-92.571 95.429.571 8 .571 24 0 74.286-21.714 148.286t-66 142-105.429 120.286-147.429 83.429-184.571 31.143q-154.857 0-283.429-82.857 20 2.286 44.571 2.286 128.571 0 229.143-78.857-60-1.143-107.429-36.857t-65.143-91.143q18.857 2.857 34.857 2.857 24.571 0 48.571-6.286-64-13.143-106-63.714t-42-117.429v-2.286q38.857 21.714 83.429 23.429-37.714-25.143-60-65.714t-22.286-88q0-50.286 25.143-93.143 69.143 85.143 168.286 136.286t212.286 56.857q-4.571-21.714-4.571-42.286 0-76.571 54-130.571t130.571-54q80 0 134.857 58.286 62.286-12 117.143-44.571-21.143 65.714-81.143 101.714 53.143-5.714 106.286-28.571z"></path></svg>
  </a>
  <a aria-label="Share on Facebook" href={facebookHref} rel="noopener nofollow" target="_blank" title="Share on Facebook">
    <svg class="icon share-icon share-icon--facebook" viewBox="0 0 585 1024" aria-hidden="true"><path d="M548 6.857v150.857h-89.714q-49.143 0-66.286 20.571T374.857 240v108h167.429L520 517.143H374.857v433.714H200V517.143H54.286V348H200V223.429q0-106.286 59.429-164.857T417.714 0Q501.714 0 548 6.857z"></path></svg>
  </a>
</section>
<section id="comm">
  <h3 id="comm-t">Comment</h3>
  <a aria-label="Comment on Reddit" href="https://www.reddit.com/r/musclehacking/" target="_blank" rel="noopener" title="Comment on Reddit">
