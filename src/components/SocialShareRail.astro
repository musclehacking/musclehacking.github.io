  title,
  documentTitle,
  emailSubject = 'Worth a read',
  emailBody,
} = Astro.props;
const url = `https://www.musclehacking.com${canonicalPath}`;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDocumentTitle = encodeURIComponent(documentTitle);
const twitterHref = `https://twitter.com/intent/tweet?text=${encodedTitle}%20${encodedUrl}&via=musclehacking`;
const facebookHref = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&title=${encodedDocumentTitle}`;
const linkedInHref = `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedDocumentTitle}`;
const emailHref = `mailto:?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody ?? `You might find this interesting: ${url}`)}`;

/* Production anchor.js tippy arrow paths (16x6 SVG, shadow plus fill). */
