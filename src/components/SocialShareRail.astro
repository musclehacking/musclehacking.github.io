---

<aside id="sh-box" aria-label="Share this page" aria-hidden="true" inert data-social-share-rail>
  <div id="tw-box-b" class="sh-box2">
    <div id="tw-box">
      <a href={twitterHref} target="_blank" rel="noopener nofollow" aria-label="Share on Twitter">
        <div class="box-s">
          <svg viewBox="0 0 951 1024" class="icon twi" aria-hidden="true"><path d={twitterPath} class="path1"></path></svg>
        </div>
      </a>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="tw" data-placement="right" data-state="hidden" data-share-tooltip role="tooltip"><span class="project-tip-content share-rail-tooltip">Share on Twitter</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
    </div>
  </div>
  <div id="f-box-b" class="sh-box2">
    <div id="f-box">
      <a href={facebookHref} target="_blank" rel="noopener nofollow" aria-label="Share on Facebook">
        <div class="box-s">
          <svg id="faceb" viewBox="0 0 585 1024" class="icon" aria-hidden="true"><path d={facebookPath} class="path1"></path></svg>
        </div>
      </a>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="fa" data-placement="right" data-state="hidden" data-share-tooltip role="tooltip"><span class="project-tip-content share-rail-tooltip">Share on Facebook</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
    </div>
  </div>
  <div id="li-box-b" class="sh-box2">
    <div id="li-box">
      <a href={linkedInHref} target="_blank" rel="noopener nofollow" aria-label="Share on Linkedin">
        <div class="box-s">
          <svg id="lkn" viewBox="0 0 512 512" class="icon" aria-hidden="true"><path d={linkedInPath} class="path1"></path></svg>
        </div>
      </a>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="lkn" data-placement="right" data-state="hidden" data-share-tooltip role="tooltip"><span class="project-tip-content share-rail-tooltip">Share on Linkedin</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
    </div>
  </div>
  <div id="e-box-b" class="sh-box2">
    <div id="e-box">
      <a href={emailHref} aria-label="Share by email">
        <div class="box-s">
          <svg id="eml" class="icon" viewBox="0 0 384 384" aria-hidden="true"><path d={emailPath} fill="#fff"></path></svg>
        </div>
      </a>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="em" data-placement="right" data-state="hidden" data-share-tooltip role="tooltip"><span class="project-tip-content share-rail-tooltip">Email this to Someone</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
    </div>
  </div>
  <div id="l-box-b" class="sh-box2">
    <div id="l-box">
      <a href={url} data-copy-page-link aria-label="Copy page link">
        <div class="box-s">
          <svg id="lnk" class="icon" viewBox="0 0 512 512" aria-hidden="true"><path d={copyLinkPaths[0]} fill="#fff"></path><path d={copyLinkPaths[1]} fill="#fff"></path></svg>
        </div>
      </a>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="link" data-placement="right" data-state="hidden" data-share-tooltip role="tooltip"><span class="project-tip-content share-rail-tooltip">Click to Copy URL</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
      <span class="project-tip-root share-rail-tooltip-root"><span class="project-tip-box" data-theme="link" data-placement="right" data-state="hidden" data-share-feedback role="status"><span class="project-tip-content share-rail-tooltip" data-copy-page-feedback>Link Copied!</span><span class="project-tip-arrow" aria-hidden="true"><svg width="16" height="6"><path class="svg-arrow" d={arrowShadow}></path><path class="svg-content" d={arrowFill}></path></svg></span></span></span>
    </div>
  </div>
</aside>

<script>
  import '../scripts/social-share';
</script>
