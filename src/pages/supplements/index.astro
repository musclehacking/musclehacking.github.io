---
import SupplementExplorer from '../../components/SupplementExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import SectionEnding from '../../components/article/SectionEnding.astro';
import { routeByPath } from '../../config/routes';
import { site } from '../../config/site';
import { resolvePageMetadata } from '../../lib/metadata';

const route = routeByPath.get('/supplements/');

if (!route) throw new Error('Missing /supplements/ route registry entry.');

const heading = route.heading!;
const metadata = {
  title: route.title,
  description: route.description,
  canonicalPath: route.path,
  image: '/img/muscle-building-supplement-stack.png',
  socialTitle: 'Beyond the Hype: Supplements That Work',
};
const { documentTitle } = resolvePageMetadata(metadata, site);
---

<BaseLayout {metadata}>
  <main class="supplements-page" data-heading-links>
    <h1>{heading}</h1>
    <p class="byline">By {site.authorDisplayName} — Updated March 2024, Posted August 2023</p>
    <Callout class="supplement-note">
      <p>This is my summarized supplement research after 10+ years of reading scientific studies and listening to (real) experts in nutrition. Learn more <a href="#supplement-information" data-supplement-information-link>here</a>.</p>
    </Callout>
    <SupplementExplorer />
    <SectionEnding section="supplements" title={heading} {documentTitle} shareTitle={metadata.socialTitle} />
  </main>
</BaseLayout>

<script>
  import '../../scripts/heading-links';
</script>

<style is:global>
  .supplements-page {
    position: relative;
    width: 700px;
    margin: 14px auto 0;
  }

  .supplements-page h1 {
    margin: 0 0 8px -2.63px;
  }

  .supplements-page .byline {
    margin: 0 0 20px;
    color: inherit;
    font-size: 21px;
    line-height: 35px;
  }

  .supplements-page > .supplement-note p {
    margin-top: 0;
    font-size: inherit;
  }

  @media (max-width: 820px) {
    .supplements-page {
      width: min(500px, calc(100% - 40px));
      margin-left: 20px;
      margin-right: 0;
    }

    .supplements-page > h1,
    .supplements-page > .byline {
      width: 100%;
    }

  }

  @media (max-width: 767px) {
    .supplements-page .byline {
      font-size: 18px;
    }

  }
</style>
