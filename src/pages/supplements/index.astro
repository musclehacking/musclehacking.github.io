---
import SupplementExplorer from '../../components/SupplementExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import ArticleEnding from '../../components/article/ArticleEnding.astro';
import { routeByPath } from '../../config/routes';
import { site } from '../../config/site';
import { resolvePageMetadata } from '../../lib/metadata';

const route = routeByPath.get('/supplements/');

if (!route) throw new Error('Missing /supplements/ route registry entry.');

const metadata = {
  title: route.title,
  description: route.description,
  canonicalPath: route.path,
  image: '/img/muscle-building-supplement-stack.png',
  socialTitle: 'Beyond the Hype: Supplements That Work',
};
const { documentTitle } = resolvePageMetadata(metadata, site);
---

<BaseLayout {metadata}>
  <main class="supplements-page" data-heading-links>
    <h1>Muscle Building Supplement Stack (Based on Research)</h1>
    <p class="byline">By Jay — Updated March 2024, Posted August 2023</p>
    <Callout class="supplement-note">
      <p>This is my summarized supplement research after 10+ years of reading scientific studies and listening to (real) experts in nutrition. Learn more <a href="#supplement-information" data-supplement-information-link>here</a>.</p>
    </Callout>
    <SupplementExplorer />
    <ArticleEnding
      canonicalPath="/supplements/"
      title="Muscle Building Supplement Stack (Based on Research)"
      {documentTitle}
      formId="supplements-bottom"
      campaign="supplements-bottom"
      placement="longform-bottom"
      previous={{ href: '/blog/best-protein-powder-for-building-muscle', label: 'Read Something Similar', title: 'Best Protein Powder for Muscle Gain: An Evidence-Based Approach' }}
      next={{ href: '/blog/reject-modernity-embrace-masculinity', label: 'Read Something Different', title: 'Reject Modernity, Embrace Masculinity: The Meaning Behind The Meme' }}
      wrapTitles
      disclaimer="generic"
      floatingShare
      shareTitle="Beyond the Hype: Supplements That Work"
      twitterText="Check+out+this+supplement+guide:+https://www.musclehacking.com/supplements/%20from%20@musclehacking"
    />
  </main>
</BaseLayout>

<script>
  import '../../scripts/heading-links';
</script>

<style is:global>
  .supplements-page {
    position: relative;
    width: 700px;
    margin: 14px auto 0;
  }

  .supplements-page h1 {
    margin: 0 0 8px -2.63px;
  }

  .supplements-page .byline {
    margin: 0 0 20px;
    color: inherit;
    font-size: 21px;
    line-height: 35px;
  }

  .supplement-note {
    border-left: 4px solid #2f81f7;
    margin: 0 0 25px;
    padding: 0 16px;
  }

  .supplement-note p {
    margin: -3px 0 0;
    font-size: 0.9em;
    line-height: 1.58;
  }

  .supplements-page > .supplement-note p {
    margin-top: 0;
    font-size: inherit;
  }

  .supplements-page .supplement-filter-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .supplements-page .supplement-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 5px 25px;
  }

  .supplements-page .supplement-filters button {
    border: 1px solid #4c88af;
    border-radius: 8px;
    background: #4c88af;
    box-shadow: 0 1px 3px rgb(0 0 0 / 10%), 0 1px 2px -1px rgb(0 0 0 / 10%);
    color: white;
    padding: 6px 12px;
    font: 16px/1.5 muscle2, Georgia, Cambria, 'Times New Roman', serif;
    cursor: pointer;
  }

  .supplements-page .supplement-filters button.active {
    border-radius: 16px;
    border-color: #1f618d;
    background: #1f618d;
    color: white;
  }

  .supplements-page .supplement-filters button:not(.active):not([data-supplement-filter='information']):hover {
    border-color: #397197;
    background: #397197;
  }

  .supplements-page .supplement-filters button[data-supplement-filter='information']:not(.active) {
    border-color: #6fa4c9;
    background: #6fa4c9;
  }

  .supplements-page .supplement-filters button:active {
    border-color: #1f618d !important;
    background: #1f618d !important;
    box-shadow: inset 0 3px 5px rgb(0 0 0 / 13%);
  }

  .supplements-page .supplement-filters button:focus-visible {
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgb(0 123 255 / 25%);
  }

  .supplement-toc {
    position: fixed;
    top: 84px;
    left: 12px;
    width: 150px;
    font-size: 16px;
    line-height: 1.8;
  }

  .supplement-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .supplement-toc a {
    color: #6f6f6f;
    text-decoration: none;
  }

  .supplements-page .supplement-card {
    border: 0;
    padding: 0;
  }

  .supplements-page .supplement-heading {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 4px;
    margin: 42px 0 0;
  }

  /* Legacy `.category-top .heading-wrapper { margin-top: 22px }`; later wrappers use 42px. */
  .supplements-page .supplement-card.category-top .supplement-heading,
  .supplements-page .supplement-card:first-of-type .supplement-heading {
    margin-top: 22px;
  }

  .supplements-page .supplement-card h2 {
    margin: 0 0 0 -2.13px;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .supplements-page .evidence-badge {
    border: 0;
    border-radius: 5px;
    background: rgb(37 167 92 / 95%);
    color: white;
    padding: 2px 8px;
    font: 600 18.9px/1.15 muscle2, Georgia, Cambria, 'Times New Roman', serif;
    text-transform: lowercase;
    text-decoration: none;
    vertical-align: middle;
  }

  .supplements-page .evidence-badge:hover,
  .supplements-page .evidence-badge:focus-visible,
  .supplements-page .evidence-badge[aria-expanded='true'] {
    background: rgb(37 167 92 / 95%);
  }

  .supplement-category-note {
    margin-bottom: 10px;
  }

  .supplement-category-note p {
    margin-top: 0;
  }

  .supplement-category-note--important {
    border-left-color: #a371f7;
  }

  .supplement-category-note--important strong {
    color: #a371f7;
  }

  .supplements-page .supplement-detail h3 {
    font-size: 32px;
    line-height: 1.22;
    letter-spacing: -0.012em;
    margin: 30px 0 0 -1.63px;
  }

  .supplements-page .supplement-detail h3 + p {
    margin: 8px 0 0;
  }

  /* Legacy `.normalize-headings h4, h5`: 28px, 30px top margin, 1.22 line height;
     `h3 + h4 { margin-top: 20px }`; `h4 + p, h5 + p { margin-top: 6px }`. */
  .supplements-page .supplement-detail :is(h4, h5) {
    font-size: 28px;
    line-height: 1.22;
    letter-spacing: -0.012em;
    margin: 30px 0 0 -1.63px;
  }

  .supplements-page .supplement-detail h3 + :is(h4, h5) {
    margin-top: 20px;
  }

  .supplements-page .supplement-detail :is(h4, h5) + p {
    margin-top: 6px;
  }

  .supplements-page .supplement-detail :is(h2, h3) + :is(ul, ol) {
    margin-top: 8px;
  }

  /* "What is this?" and References share the legacy `.normalize-headings` article rhythm. */
  .supplements-page [data-supplement-support] h2 {
    margin: 42px 0 0 -2.13px;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .supplements-page [data-supplement-support] h3 {
    margin: 30px 0 0 -1.63px;
    font-size: 32px;
    line-height: 1.22;
    letter-spacing: -0.012em;
  }

  .supplements-page [data-supplement-support] :is(h4, h5) {
    margin: 30px 0 0 -1.63px;
    font-size: 28px;
    line-height: 1.22;
    letter-spacing: -0.012em;
  }

  .supplements-page [data-supplement-support] p {
    margin: 29px 0 0;
    line-height: 35px;
  }

  .supplements-page [data-supplement-support] :is(h2, h3) + :is(p, ul, ol) {
    margin-top: 8px;
  }

  .supplements-page [data-supplement-support] :is(h4, h5) + p {
    margin-top: 6px;
  }

  /* The support copy is injected inside a wrapper div, so descendant selectors are used. */
  .supplements-page [data-supplement-support] :is(ul, ol) {
    margin: 29px 0 0;
    padding: 0;
  }

  .supplements-page [data-supplement-support] li {
    margin: 0 0 5px 30px;
  }

  .supplements-page [data-supplement-support] li > :is(ul, ol) {
    margin: 0;
  }

  .supplements-page [data-supplement-support] ol.ref-list {
    margin-top: 8px;
  }

  .supplements-page .ref {
    font-size: 17px;
  }

  /* Legacy `.normalize-headings h3` also sizes the Share and Comment headings here. */
  .supplements-page :is(#share-t, #comm-t) {
    font-size: 32px;
    line-height: 1.22;
    letter-spacing: -0.012em;
  }

  .supplements-page [data-supplement-support] .ref-list > .ref {
    margin-left: 1.4em;
  }

  /* Legacy addon.css: paragraphs run at 35px with a 29px top margin, list items at the
     body 1.58 line height with a 5px bottom margin. */
  .supplements-page .supplement-detail p {
    margin: 29px 0 0;
    line-height: 35px;
    overflow-wrap: anywhere;
  }

  .supplements-page .supplement-detail li {
    margin-bottom: 5px;
    line-height: 1.58;
    overflow-wrap: anywhere;
  }

  .supplements-page .supplement-detail a.inl-ref {
    box-shadow: none;
    color: #206593;
    text-decoration: none;
  }

  .supplements-page .supplement-detail a.inl-ref > sup {
    font-size: 70%;
    line-height: 0;
    position: relative;
    top: -0.5em;
    vertical-align: baseline;
  }

  .supplements-page .supplement-detail > ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .supplements-page .evidence-badge[data-evidence-level='low'] {
    background: rgb(231 77 60 / 85%);
  }

  .supplements-page .evidence-badge[data-evidence-level='medium'] {
    background: rgb(245 178 59 / 95%);
  }

  .supplements-page .evidence-badge[data-evidence-level='high'] {
    background: rgb(37 167 92 / 95%);
  }

  .supplements-page .supplement-detail > ul > li {
    margin: 0 0 5px 30px;
  }

  .supplements-page .supplement-detail > ul > li::before {
    box-sizing: border-box;
    content: '•';
    display: inline-block;
    font-size: 16.8px;
    margin-left: -4.875em;
    padding-right: 15px;
    padding-top: 4px;
    position: absolute;
    text-align: right;
    width: 4.875em;
  }

  @media (max-width: 820px) {
    .supplements-page {
      width: min(500px, calc(100% - 40px));
      margin-left: 20px;
      margin-right: 0;
    }

    .supplements-page > h1,
    .supplements-page > .byline {
      width: 100%;
    }

    .supplement-toc {
      display: none;
    }
  }

  /* Legacy 767px mobile rhythm: `article div.post-body ol, p, ul { margin-top: 21px }`. */
  @media (max-width: 767px) {
    .supplements-page .supplement-detail p,
    .supplements-page .supplement-detail > ul,
    .supplements-page [data-supplement-support] p,
    .supplements-page [data-supplement-support] :is(ul, ol) {
      margin-top: 21px;
    }

    .supplements-page .supplement-detail h3 + p,
    .supplements-page .supplement-detail :is(h2, h3) + :is(ul, ol),
    .supplements-page [data-supplement-support] :is(h2, h3) + :is(p, ul, ol),
    .supplements-page [data-supplement-support] ol.ref-list {
      margin-top: 8px;
    }

    .supplements-page .supplement-detail :is(h4, h5) + p,
    .supplements-page [data-supplement-support] :is(h4, h5) + p {
      margin-top: 6px;
    }

    .supplements-page .supplement-detail li > :is(ul, ol),
    .supplements-page [data-supplement-support] li > :is(ul, ol) {
      margin-top: 21px;
    }

    /* `.normalize-headings h2/h3` keep their desktop size and margins on mobile (id-level
       specificity beats the generic mobile `h3` rule); only h4/h5 rescale. */
    .supplements-page .supplement-card h2,
    .supplements-page [data-supplement-support] h2 {
      margin: 42px 0 0 -2.13px;
      font-size: 40px;
      line-height: 1.15;
    }

    .supplements-page .supplement-card h2 {
      margin-top: 0;
    }

    .supplements-page .supplement-detail h3,
    .supplements-page [data-supplement-support] h3 {
      margin: 30px 0 0 -1.63px;
      font-size: 32px;
      line-height: 1.22;
    }

    /* Measured legacy 390px supplement h4/h5: 28px with the desktop 30px top margin. */
    .supplements-page .supplement-detail :is(h4, h5),
    .supplements-page [data-supplement-support] :is(h4, h5) {
      margin: 30px 0 0 -1.63px;
      font-size: 28px;
    }

    .supplements-page .supplement-detail h3 + :is(h4, h5) {
      margin-top: 20px;
    }

    .supplements-page .ref {
      font-size: 14px;
    }
  }
</style>
