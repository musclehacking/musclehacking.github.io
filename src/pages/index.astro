---
import { routeByPath } from '../config/routes';
import HomeListing from '../components/HomeListing.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
const route = routeByPath.get('/')!;
---

<ContentLayout
  title={route.title}
  titleMode={route.titleMode}
  description={route.description}
  canonicalPath="/"
>
  <HomeListing />
</ContentLayout>
