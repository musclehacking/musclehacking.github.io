---
import { site } from '../../config/site';
import { routeByPath } from '../../config/routes';
import NewsletterForm from '../../components/NewsletterForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
const route = routeByPath.get('/join/')!;
---

<BaseLayout metadata={{ title: route.title, titleMode: route.titleMode, description: route.description, canonicalPath: '/join/', indexable: false }}>
  <main class="article-page join-page">
    <h1>Ready to get serious?</h1>
    <p>This is a newsletter for people who are ready to get serious about their health and fitness.</p>
    <p>No more fads. No more yo-yo dieting.</p>
    <p>No more excuses.</p>
    <p>Join thousands of subscribers who actually want to transform their physique—and not just talk about it.</p>
    <NewsletterForm formId="join" campaign="join" buttonText={site.newsletter.buttonText} placement="join" hideLabel />
    <p class="join-assurance"><em>No courses. No all-banana diets. Unsubscribe at any time. And yes, it’s free.</em></p>
  </main>
</BaseLayout>
