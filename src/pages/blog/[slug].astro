---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { contentComponents } from '../../components/content';
import { getPublishedPosts, resolveArticle } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedPosts();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const article = await resolveArticle(entry, 'blog');
---

<ArticleLayout {article} class={`blog-${entry.id}`}>
  <Content components={contentComponents} />
</ArticleLayout>
