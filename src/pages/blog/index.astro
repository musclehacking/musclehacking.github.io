---
import HomeListing from '../../components/HomeListing.astro';
import { routeByPath } from '../../config/routes';
import ContentLayout from '../../layouts/ContentLayout.astro';

const route = routeByPath.get('/blog/');

if (!route) throw new Error('Missing /blog/ route registry entry.');
---

<ContentLayout
  title={route.title}
  titleMode={route.titleMode}
  description={route.description}
  canonicalPath={route.path}
>
  <HomeListing />
</ContentLayout>
