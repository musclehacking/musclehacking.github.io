---
import { getEntry, render } from 'astro:content';
import { contentComponents } from '../../components/content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { resolveArticle } from '../../lib/content';
const entry = await getEntry('pages', 'books');
if (!entry) throw new Error('Missing pages/books content entry.');
const { Content } = await render(entry);
const article = await resolveArticle(entry, 'pages');
---
<ArticleLayout {article} class="books-page"><Content components={contentComponents} /></ArticleLayout>
