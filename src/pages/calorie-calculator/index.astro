---
import { routeByPath } from '../../config/routes';
import Calculator from '../../features/calculator/Calculator';
import CalculatorNewsletterPrompts from '../../components/CalculatorNewsletterPrompts.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculatorGuideIntro from '../../components/CalculatorGuideIntro.astro';
import SectionEnding from '../../components/article/SectionEnding.astro';
import { calculatorGuideRemainderHtml } from '../../content/pages/calculator-guide';
import { site } from '../../config/site';
import { resolvePageMetadata } from '../../lib/metadata';

const route = routeByPath.get('/calorie-calculator/')!;
const guideTitle = 'Calorie & Macro Calculator: How To Use It';
const metadata = {
  title: route.title,
  description: route.description,
  canonicalPath: '/calorie-calculator/',
};
const { documentTitle } = resolvePageMetadata(metadata, site);
---

<BaseLayout {metadata}>
  <main class="calculator-page">
    <Calculator client:load />
  </main>
  <article class="calculator-guide" data-heading-links>
    <header>
      <h2 id="how-to-use">{guideTitle}</h2>
      <p>By {site.authorDisplayName} — Updated April 2026</p>
    </header>
    <div class="legacy-content">
      <CalculatorGuideIntro />
      <Fragment set:html={calculatorGuideRemainderHtml} />
    </div>
    <SectionEnding section="calculator" title={guideTitle} {documentTitle} />
  </article>
  <CalculatorNewsletterPrompts />
</BaseLayout>

<script>
  import '../../scripts/heading-links';
</script>
